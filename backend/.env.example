# Copy to backend/.env and replace the secret. Never commit the real .env file.
ECHOMART_JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# ECHOMART_DATABASE_URL is optional; the default is backend/data/echomart.db (absolute, so the working directory does not matter).
ECHOMART_CORS_ORIGINS=["http://localhost:4300"]
ECHOMART_ADMIN_EMAILS=["you@example.com"]
ECHOMART_COOKIE_SECURE=false
# Optional: development origin pattern. Leave empty in production.
ECHOMART_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
